# Copy to .env.local for local development. Never commit real values.
# Production/preview values live in Vercel project env vars (PRD §9.3).

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — local values are printed by `pnpm supabase start` (API_URL, ANON_KEY, SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Sprint 6) — PayTPV / Redsys per decision D1 (docs/decisions.md)
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SECRET_KEY=
REDSYS_ENV=test
# Redsys' public sandbox values, for local testing only: merchant 999008881,
# terminal 1, key sq7HjrUOBfKmC576ILgskD5srU870gJ7. Production values come from
# the bank and live only in Vercel env vars.
# Local end-to-end checks can point at a fake gateway (ignored on production):
# REDSYS_BASE_URL=http://localhost:4010

# Email (Sprint 6)
RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=

# Analytics (consent-gated)
NEXT_PUBLIC_GTM_ID=

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional)
SENTRY_DSN=

# Media (Sprint 7): "true" once images are copied into Supabase Storage.
# Until then tour images are served from the legacy WordPress URLs.
MEDIA_FROM_STORAGE=false

# SEO: "true" only on production at launch (Sprint 9). Anything else = noindex + robots disallow.
NEXT_PUBLIC_ALLOW_INDEXING=false
