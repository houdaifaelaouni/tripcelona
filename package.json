{
  "name": "tripcelona-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "vitest run tests/db && supabase test db",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "test": "vitest run tests/unit",
    "ops": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ops.ts",
    "media:sync": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/media-pipeline.ts",
    "content:import": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/content-import.ts",
    "check:urls": "node --import tsx scripts/check-urls.ts",
    "check:env": "node --env-file-if-exists=.env.check --import tsx scripts/check-env.ts",
    "e2e:prepare": "node --conditions=react-server --import tsx tests/e2e/prepare.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-link": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.23",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.1",
    "lucide-react": "1.48.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "node-html-parser": "9.0.7",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
